{
  "name": "ff-webhid",
  "private": true,
  "version": "2.2.0",
  "scripts": {
    "release": "npx commit-and-tag-version",
    "lint": "npx web-ext lint -s addon",
    "format": "npx prettier addon/**/*.js -w",
    "build:addon": "node scripts/build-addon.mjs"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.0",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "web-ext": "^10.5.0"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.8",
    "shell-quote": "1.10.0"
  }
}
