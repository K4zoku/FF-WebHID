{
  "config": {
    "cargoManifest": "crates/Cargo.toml",
    "playwrightConfig": "tests/playwright.config.ts",
    "playwrightBenchmarkConfig": "tests/playwright.benchmark.config.ts",
    "playwrightForwarderConfig": "tests/playwright.forwarder.config.ts"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:addon",
    "build:addon": "node scripts/build-addon.mjs",
    "build:daemon": "cargo build --release -p webhid-daemon --manifest-path $npm_package_config_cargoManifest",
    "build:daemon:debug": "cargo build -p webhid-daemon --manifest-path $npm_package_config_cargoManifest",
    "build:deb": "node scripts/build-package.mjs deb",
    "build:mock": "cargo build --release -p webhid-mock --manifest-path $npm_package_config_cargoManifest",
    "build:mock:debug": "cargo build -p webhid-mock --manifest-path $npm_package_config_cargoManifest",
    "build:msi": "node scripts/build-package.mjs msi",
    "build:native": "cargo build --release -p webhid-daemon -p webhid-native-messaging --manifest-path $npm_package_config_cargoManifest",
    "build:native:debug": "cargo build -p webhid-daemon -p webhid-native-messaging --manifest-path $npm_package_config_cargoManifest",
    "build:nm": "cargo build --release -p webhid-native-messaging --manifest-path $npm_package_config_cargoManifest",
    "build:nm:debug": "cargo build -p webhid-native-messaging --manifest-path $npm_package_config_cargoManifest",
    "build:rpm": "node scripts/build-package.mjs rpm",
    "build:rs": "cargo build --release --manifest-path $npm_package_config_cargoManifest",
    "build:rs:debug": "cargo build --manifest-path $npm_package_config_cargoManifest",
    "clean": "rm -rf dist/ && cargo clean --manifest-path $npm_package_config_cargoManifest",
    "clean:addon": "rm -rf dist/addon/ dist/webhid-addon*.xpi",
    "clean:rs": "cargo clean --manifest-path $npm_package_config_cargoManifest",
    "format": "npx prettier . --write",
    "format:css": "npx prettier 'addon/**/*.css' --write",
    "format:docs": "npx prettier '**/*.md' --write",
    "format:html": "npx prettier 'addon/**/*.html' --write",
    "format:js": "npx prettier 'addon/**/*.js' --write",
    "format:json": "npx prettier 'addon/**/*.json' '*.json' --write",
    "format:rs": "cargo fmt --manifest-path $npm_package_config_cargoManifest",
    "lint": "npx web-ext lint -s addon",
    "lint:js": "npx eslint addon/js/",
    "lint:rs": "cargo clippy --manifest-path $npm_package_config_cargoManifest",
    "lint:test": "npx eslint tests/ eslint.config.ts",
    "release": "npx commit-and-tag-version",
    "release:major": "npx commit-and-tag-version --release-as major",
    "release:minor": "npx commit-and-tag-version --release-as minor",
    "release:patch": "npx commit-and-tag-version --release-as patch",
    "test": "npx playwright test --config $npm_package_config_playwrightConfig",
    "test:browser": "npm run build:addon && EXTENSION_PATH=dist/addon npx playwright test --config $npm_package_config_playwrightConfig --project=firefox-browser",
    "test:browser:src": "npx playwright test --config $npm_package_config_playwrightConfig --project=firefox-browser",
    "test:debug": "npx playwright test --config $npm_package_config_playwrightConfig --debug",
    "test:e2e": "npm run test:e2e:daemon && npm run test:e2e:forwarder",
    "test:e2e:daemon": "npx playwright test --config $npm_package_config_playwrightConfig --project=firefox-e2e-daemon",
    "test:e2e:forwarder": "npx playwright test --config $npm_package_config_playwrightForwarderConfig --project=firefox-e2e-forwarder",
    "test:benchmark": "npx playwright test --config $npm_package_config_playwrightBenchmarkConfig --project=firefox-benchmark",
    "test:benchmark:loss": "npx playwright test --config $npm_package_config_playwrightBenchmarkConfig --project=firefox-benchmark-loss",
    "test:benchmark:chromium": "npx playwright test --config $npm_package_config_playwrightBenchmarkConfig --project=chromium-benchmark",
    "test:headed": "npx playwright test --config $npm_package_config_playwrightConfig --headed",
    "test:rs": "cargo test --manifest-path $npm_package_config_cargoManifest"
  },
  "name": "ff-webhid",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.1.2",
    "commit-and-tag-version": "^13.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "firefox-webext-playwright-harness": "github:duckduckgo/firefox-webext-playwright-harness#c339f623db3b4ee464e6460e32287ca2ee588115",
    "jiti": "^2.7.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "typescript-eslint": "^8.65.0",
    "web-ext": "^10.5.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "shell-quote": "1.10.0"
  }
}
