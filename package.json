{
  "name": "ff-webhid",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "release": "nubx commit-and-tag-version",
    "release:minor": "nubx commit-and-tag-version --release-as minor",
    "release:patch": "nubx commit-and-tag-version --release-as patch",
    "lint": "nubx web-ext lint -s addon",
    "lint:js": "nubx eslint addon/js/",
    "format": "nubx prettier addon/**/*.js addon/**/*.css addon/**/*.html -w",
    "build": "make build && npm run build:addon",
    "build:addon": "node scripts/build-addon.mjs",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/windows/build-msi.ps1",
    "test": "nubx playwright test --config tests/playwright.config.ts",
    "test:browser": "nubx playwright test --config tests/playwright.config.ts --project=firefox-browser",
    "test:e2e": "nubx playwright test --config tests/playwright.config.ts --project=firefox-e2e",
    "test:headed": "nubx playwright test --config tests/playwright.config.ts --headed",
    "test:debug": "nubx playwright test --config tests/playwright.config.ts --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "commit-and-tag-version": "^13.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "firefox-webext-playwright-harness": "github:duckduckgo/firefox-webext-playwright-harness#0.3.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "web-ext": "^10.5.0"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.8",
    "shell-quote": "1.10.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  }
}
