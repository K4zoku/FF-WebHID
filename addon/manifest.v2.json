{
  "manifest_version": 2,
  "name": "WebHID",
  "version": "3.1.0",
  "description": "WebHID API implementation for Firefox",
  "icons": {
    "48": "icons/icon.svg"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "notifications",
    "theme",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "js/utils/bootstrap.js",
      "js/utils/i18n.js",
      "js/utils/resource.js",
      "js/utils/http.js",
      "js/utils/logger.js",
      "js/utils/settings.js",
      "js/utils/base64.js",
      "js/utils/descriptor-tlv.js",
      "js/background/state.js",
      "js/background/storage.js",
      "js/background/packed.js",
      "js/background/state_ops.js",
      "js/utils/bundle-files.js",
      "js/background/bundle.js",
      "js/background/nm.js",
      "js/background/csp.js",
      "js/background/messages.js",
      "js/background/webrequest.js",
      "js/background/index.js"
    ]
  },
  "page_action": {
    "default_popup": "js/internal/pages/popup/index.html",
    "default_icon": "icons/gamepad.svg",
    "show_matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "WebHID"
  },
  "options_ui": {
    "page": "js/internal/pages/settings/index.html",
    "browser_style": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/utils/bootstrap.js",
        "js/utils/bundle-files.js",
        "js/utils/i18n.js",
        "js/content/isolated/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/utils/bootstrap.js",
        "js/utils/i18n.js",
        "js/utils/resource.js",
        "js/utils/http.js",
        "js/utils/logger.js",
        "js/utils/device.js",
        "js/utils/descriptor-tlv.js",
        "js/utils/settings.js",
        "js/utils/theme-sync.js",
        "js/content/isolated/picker/index.js",
        "js/content/isolated/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [],
  "applications": {
    "gecko": {
      "id": "webhid@k4zoku.dev"
    }
  },
  "default_locale": "en_US"
}
