{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.1.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "148",
  "message_serialization": "structured_clone",
  "icons": {
    "48": "icons/icon48.png"
  },
  "permissions": ["nativeMessaging", "storage", "notifications", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "js/internal/pages/popup/index.html#settings",
    "default_icon": {
      "16": "icons/gamepad16.png",
      "32": "icons/gamepad32.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "options_ui": {
    "page": "js/internal/pages/settings/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["isolated-world.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [],
  "default_locale": "en_US"
}
