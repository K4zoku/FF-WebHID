+// Local patch (FF-WebHID): on Linux with the pure-Rust hidraw backend, the
+// underlying linux_native::HidDevice is Sync (shared state is AtomicBool +
+// Mutex, and OwnedFd supports concurrent syscalls on the same fd), so the
+// daemon can share one fd between reader and writer without a Mutex. Only
+// claimed when the linux-native backend is selected; the C backends remain
+// !Sync and callers wrap them in a Mutex.
+#[cfg(all(feature = "linux-native", target_os = "linux"))]
+unsafe impl Sync for HidDevice {}
