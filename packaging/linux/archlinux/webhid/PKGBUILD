# Maintainer: K4zoku <k4zoku@pm.me>
#
# This PKGBUILD builds the WebHID daemon + native-messaging host from the
# latest git commit (git package; version derived via git describe, so no
# manual bump per release). Supports both x86_64 and aarch64.

_pkgbase=webhid
pkgname=${_pkgbase}-git
pkgver=3.0.0
pkgrel=1
pkgdesc='WebHID implementation for Firefox via a native-messaging bridge and hidraw daemon'
arch=('x86_64' 'aarch64')
url='https://github.com/K4zoku/FF-WebHID'
license=('MIT')
depends=('libudev.so')
makedepends=('cargo' 'pkgconf' 'git')
optdepends=('webhid-addon: Firefox browser extension (system-wide install)')
provides=("${_pkgbase}")
conflicts=("${_pkgbase}")
install=webhid-git.install
source=("${_pkgbase}::git+${url}.git")
sha256sums=('SKIP')
options=('!lto' '!debug')

pkgver() {
    cd "${_pkgbase}"
    git describe --tags | sed 's/^v//;s/_/./;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cargo fetch \
        --target "$CARCH-unknown-linux-gnu" \
        --manifest-path "$srcdir/${_pkgbase}/crates/Cargo.toml"
}

build() {
    make -C "$srcdir/${_pkgbase}" build CARGO_ARGS=--frozen
}

package() {
    local _root="$srcdir/${_pkgbase}"

    make -C "$_root" install-system DESTDIR="$pkgdir" \
        PREFIX=/usr \
        SYSTEMD_DIR=/usr/lib/systemd/system \
        SYSTEM_NM_DIR=/usr/lib/mozilla/native-messaging-hosts

    # Native-messaging manifests for other Gecko-based browsers: both the
    # forwarder and the daemon-as-NM-host manifests, so both daemon modes
    # are registered on every supported browser.
    local _nm_dir="$pkgdir/usr/lib/mozilla/native-messaging-hosts"
    for f in webhid.forwarder_nm_host.json webhid.daemon_nm_host.json; do
        install -Dm644 "$_nm_dir/$f" \
            "$pkgdir/usr/lib/librewolf/native-messaging-hosts/$f"
        install -Dm644 "$_nm_dir/$f" \
            "$pkgdir/usr/lib/waterfox/native-messaging-hosts/$f"
    done

    install -Dm644 "$_root/LICENSE" \
        "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
