# Template file for webhid-addon
pkgname=webhid-addon
version=3.1.0
revision=1
build_style=fetch
depends="webhid"
short_desc="WebHID browser extension for Firefox and Zen (system-wide installation)"
maintainer="K4zoku <k4zoku@pm.me>"
license="MIT"
homepage="https://github.com/K4zoku/FF-WebHID"
# Pinned AMO file URL (versioned, not the mutable latest.xpi); refresh with
# `npm run refresh:pins` after each release.
distfiles="https://addons.mozilla.org/firefox/downloads/file/4950900/webhid-3.1.0.xpi"
checksum=f34b1258949600750705f23b900697d1af908b473008ed827b0a423b58272a97

do_install() {
	_ext_id="webhid@k4zoku.dev"
	_ff_guid='{ec8030f7-c20a-464f-9b0e-13a3a9e97384}'

	# Firefox / Gecko application extension directories
	vmkdir usr/lib/mozilla/extensions/${_ff_guid}
	vmkdir usr/lib/librewolf/extensions
	vmkdir usr/lib/waterfox/extensions

	vinstall ${distfiles} 644 usr/lib/mozilla/extensions/${_ff_guid} ${_ext_id}.xpi
	vinstall ${distfiles} 644 usr/lib/librewolf/extensions ${_ext_id}.xpi
	vinstall ${distfiles} 644 usr/lib/waterfox/extensions ${_ext_id}.xpi
}
