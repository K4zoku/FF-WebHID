# Template file for webhid
pkgname=webhid
version=3.1.0
revision=1
build_style=cargo
cargo-build-args="--manifest-path crates/Cargo.toml"
cargo-exe=cargo
hostmakedepends="pkgconf"
makedepends="rustup"
depends=""
short_desc="WebHID implementation for Firefox via native-messaging bridge and hidraw daemon"
maintainer="K4zoku <k4zoku@pm.me>"
license="MIT"
homepage="https://github.com/K4zoku/FF-WebHID"
distfiles="https://github.com/K4zoku/FF-WebHID/archive/refs/tags/v${version}.tar.gz"
checksum=650994b70f45295caa21e0e1ad91a9510b0d05d63844477e7300c8bbb38b8efb

do_install() {
	# Install binaries
	vbin crates/target/release/webhid-daemon
	vbin crates/target/release/webhid-native-messaging

	# Install udev rules
	vinstall "${FILESDIR}/72-webhid.rules" 644 usr/lib/udev/rules.d

	# Install systemd service (reference for Void users with systemd)
	vinstall "${FILESDIR}/webhid-daemon.service" 644 usr/lib/systemd/system

	# Install runit service for persistent-daemon mode (Void's native service
	# manager). Enable with: sudo ln -s /etc/sv/webhid-daemon /var/service/
	# (or: vsv enable webhid-daemon). The systemd unit stays as reference.
	vinstall "${FILESDIR}/webhid-daemon/run" 755 usr/lib/sv/webhid-daemon/run

	# Install NM manifests for all Gecko browsers
	for d in mozilla librewolf waterfox; do
		vmkdir usr/lib/${d}/native-messaging-hosts
		sed 's|{{NM_BIN}}|/usr/bin/webhid-native-messaging|g' \
			manifests/webhid.forwarder_nm_host.json \
			> usr/lib/${d}/native-messaging-hosts/webhid.forwarder_nm_host.json
		sed 's|{{DAEMON_BIN}}|/usr/bin/webhid-daemon|g' \
			manifests/webhid.daemon_nm_host.json \
			> usr/lib/${d}/native-messaging-hosts/webhid.daemon_nm_host.json
	done

	# Install license
	vlicense LICENSE
}
